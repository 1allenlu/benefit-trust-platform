# Base URL of the Vested API. Leave empty to run on the built-in mock data.
VITE_API_URL=

# Live assistant (P1). Set both to turn it on; leave unset to keep the scripted replies only.
# ANTHROPIC_API_KEY is server-side only (Vercel env var) and must never get a VITE_ prefix.
VITE_LIVE_ASSISTANT=
ANTHROPIC_API_KEY=
